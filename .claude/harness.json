{
  "language": "rust",
  "framework": null,
  "packageManager": "cargo",
  "typecheck": {
    "command": "cargo check",
    "perFile": false
  },
  "test": {
    "command": "cargo test --workspace",
    "framework": "built-in + proptest"
  },
  "lint": {
    "command": "cargo clippy --workspace -- -D warnings"
  },
  "bench": {
    "command": "cargo bench"
  },
